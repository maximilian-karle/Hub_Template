# Betriebssystem und Office
.DS_Store
Thumbs.db
~$*

# Python
__pycache__/
.venv/

# Rohdaten bleiben lokal. Die Ordnerstruktur bleibt über .gitkeep erhalten.
projekte/*/data/input/**
!projekte/*/data/input/**/
!projekte/*/data/input/**/.gitkeep

# Abgeleitete Daten lassen sich aus den Rohdaten neu erzeugen.
projekte/*/data/cache/
projekte/*/data/mart/

# Binärdateien von Power BI sind nicht vergleichbar, versioniert wird die
# Logik als Text (dax_measures.md, power_query_steps.md).
*.pbix
